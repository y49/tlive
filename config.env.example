# TLive Configuration
# Copy to ~/.tlive/config.env (CLI) or .env (Docker)
# chmod 600 ~/.tlive/config.env
#
# For local development/testing, copy to .env.local and use:
#   docker compose --env-file .env.local up

# ── Core ──────────────────────────────────────────────────────────
TL_PORT=8849
TL_TOKEN=your-token-here
# Public URL for IM button callbacks (optional, for remote servers)
# TL_PUBLIC_URL=https://your-domain.com

# ── Proxy (optional) ─────────────────────────────────────────────
# Global proxy for Telegram & Discord
# Supports: http://, https://, socks5://, socks4://
# TL_PROXY=http://127.0.0.1:7890

# ── IM Channels ──────────────────────────────────────────────────
# Comma-separated: telegram,discord,feishu
TL_ENABLED_CHANNELS=

# Telegram
TL_TG_BOT_TOKEN=
TL_TG_CHAT_ID=
TL_TG_ALLOWED_USERS=
TL_TG_REQUIRE_MENTION=true
TL_TG_DISABLE_LINK_PREVIEW=true
# Webhook mode (optional — omit to use long-polling)
# TL_TG_WEBHOOK_URL=https://your-domain.com/telegram-webhook
# TL_TG_WEBHOOK_SECRET=your-random-secret
# TL_TG_WEBHOOK_PORT=8443
# Per-platform proxy (overrides TL_PROXY)
# TL_TG_PROXY=

# Discord
TL_DC_BOT_TOKEN=
TL_DC_ALLOWED_USERS=
TL_DC_ALLOWED_CHANNELS=
# TL_DC_PROXY=

# Feishu / Lark
TL_FS_APP_ID=
TL_FS_APP_SECRET=
TL_FS_ALLOWED_USERS=
TL_FS_VERIFICATION_TOKEN=
TL_FS_ENCRYPT_KEY=
TL_FS_WEBHOOK_PORT=9100

# ── Runtime ──────────────────────────────────────────────────────
# claude (default) or codex
TL_RUNTIME=claude
TL_DEFAULT_WORKDIR=
TL_DEFAULT_MODEL=

# Provider API keys (set here or as env vars)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Claude Code settings to load in bridge SDK mode
#   user    — ~/.claude/settings.json (auth, model)
#   project — + CLAUDE.md, MCP, skills
#   local   — + .claude/settings.local.json
# Default: user
TL_CLAUDE_SETTINGS=user
