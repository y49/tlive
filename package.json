{
  "name": "tlive",
  "version": "0.8.0",
  "description": "Terminal live monitoring + IM bridge for AI coding tools",
  "type": "module",
  "bin": {
    "tlive": "./scripts/cli.js"
  },
  "files": [
    "scripts/cli.js",
    "scripts/postinstall.js",
    "scripts/preuninstall.js",
    "scripts/statusline.mjs",
    "scripts/statusline.sh",
    "scripts/doctor.sh",
    "dist/src/",
    "src/",
    "bridge/dist/",
    "bridge/package.json",
    "SKILL.md",
    "references/",
    "config.env.example"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "preuninstall": "node scripts/preuninstall.js",
    "prepublishOnly": "cd bridge && npm install && npm run build && npm test",
    "build": "cd bridge && npm run build",
    "build:src": "npx esbuild src/cli/claude.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/src/tlive-claude.mjs --external:node-pty --external:ws --external:@anthropic-ai/claude-agent-sdk",
    "test": "cd bridge && npm test",
    "test:src": "npx vitest run --config vitest.config.src.ts"
  },
  "keywords": [
    "terminal",
    "monitoring",
    "claude-code",
    "telegram",
    "discord",
    "feishu",
    "ai-coding",
    "remote-terminal"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/y49/tlive"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.77",
    "@grammyjs/runner": "^2.0.3",
    "@grammyjs/transformer-throttler": "^1.2.1",
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "discord.js": "^14.25.1",
    "grammy": "^1.41.1",
    "https-proxy-agent": "^9.0.0",
    "node-pty": "^1.1.0",
    "socks-proxy-agent": "^10.0.0",
    "ws": "^8.20.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "node-pty"
    ]
  }
}
