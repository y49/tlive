#!/usr/bin/env bash
# .githooks/pre-commit — warn (don't block) when modifying frozen kernel surface.

CHANGED=$(git diff --cached --name-only | grep -E '^(src/kernel/contracts/|tests/contract/|KERNEL\.md)' || true)
if [ -n "$CHANGED" ]; then
  cat >&2 <<EOF
⚠️  You are modifying frozen kernel surface:
$CHANGED

Read KERNEL.md before continuing. If this is intentional and breaking,
prepare to bump major version (currently 1.x).

Press Enter to continue, Ctrl-C to abort.
EOF
  read -r _ < /dev/tty 2>/dev/null || true
fi
